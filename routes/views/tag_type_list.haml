%div{class: "flex"}
  %div{id: "sidebar", class: "w-40"}
    %ul
      %li
        %a{:href => "/tags/1"} Tags
      %li
        %a{:href => "/tagtypes/1"} Tag types

  %div#main
    %h2{class: "text-2xl"}
      Tag types

    %div{class: "flex flex-row justify-end"}
      %div{class: "w-40 bg-olive-600 rounded-full text-slate-300 flex justify-center items-center"}
        %a{:href => "/tagtypes/new"} Add new tag type

    %div{class: "pageNavi flex flex-row justify-center gap-2"}
      - unless @page.first_page?
        %span
          %a{:href => "/tagtypes/#{@page.prev_page}"} &#171; Prev
      %span= "[ #{@page.current_page} / #{@page.page_count} ]"
      - unless @page.last_page?
        %span
          %a{:href => "/tagtypes/#{@page.next_page}"} Next &#187;

    %div{id: "tagTypeList", class: "py-2"}
      %table{class: "table-fixed border-collapse border-t-2 border-b-2 border-olive-400"}
        %thead
          %tr{class: "border-b-2 border-olive-400 bg-slate-200"}
            %th{class: "tagTypeName w-24"}
              Name
            %th{class: "tagTypeDescription w-120"}
              Description
            %th
        %tbody
        - @tagtypes.each do |tagtype|
          %tr{class: "border-b border-olive-400 bg-white"}
            %td{class: "px-2"}
              = h tagtype.name
            %td{class: "px-2"}
              = h tagtype.description
            %td{class: "px-2"}
              %a{:href => "/tagtypes/edit/#{tagtype.id}"} (edit)

    %div{class: "pageNavi flex flex-row justify-center gap-2"}
      - unless @page.first_page?
        %span
          %a{:href => "/tagtypes/#{@page.prev_page}"} &#171; Prev
      %span= "[ #{@page.current_page} / #{@page.page_count} ]"
      - unless @page.last_page?
        %span
          %a{:href => "/tagtypes/#{@page.next_page}"} Next &#187;

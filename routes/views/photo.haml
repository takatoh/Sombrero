%main
  %div{id: "photo", class: "flex justify-center"}
    %a{:href => '/images/' + @photo.path, :target => '_blank', :rel => "noopener noreferrer"}
      %img{:src => '/images/' + @photo.sample_path}
  %div{id: "photoInfo", class: "pt-4 flex justify-center"}
    %div{class: "w-[80%]"}
      %dl{class: "flex flex-wrap"}
        %dt{class: "w-[15%] font-bold text-right"}
          Photo Id:
        %dd{class: "w-[85%] ps-3"}
          = h @photo.id.to_s
        %dt{class: "w-[15%] font-bold text-right"}
          Size:
        %dd{class: "w-[85%] ps-3"}
          = h(@photo.width.to_s + "x" + @photo.height.to_s)
          pixels
        %dt{class: "w-[15%] font-bold text-right"}
          File size:
        %dd{class: "w-[85%] ps-3"}
          = h @photo.filesize
          bytes
        %dt{class: "w-[15%] font-bold text-right"}
          MD5:
        %dd{class: "w-[85%] ps-3"}
          = h @photo.md5
        %dt{class: "w-[15%] font-bold text-right"}
          SHA256:
        %dd{class: "w-[85%] ps-3"}
          = h @photo.sha256
        %dt{class: "w-[15%] font-bold text-right"}
          Sources:
        %dd{class: "w-[85%] ps-3"}
          %ul
            - @posts.each do |post|
              %li
                %a{:href => post.url, :class => "hover:underline"}= post.url
                - unless post.page_url.nil? || post.page_url.empty?
                  [
                  %a{:href => post.page_url, :class => "hover:underline"}= hostname(post.page_url)
                  ]
                = " (#{post.date})"
        %dt{class: "w-[15%] font-bold text-right"}
          Tags:
        %dd{class: "w-[85%] ps-3"}
          %ul#tagList
            - @tags.sort_by{|t| t.name.to_s}.each do |tag|
              %li
                = h tag.name
          %a#editLink{class: "hover:underline"}
            = "(Edit)"
          %form#updateTags{ :class => "hidden", :action => "/photo/update-tags", :method => "POST", :enctype => "multipart/form-data" }
            %input#tags{ :type => "text", :name => "tags", :size => "80", :value => "#{@tags.map{|t| t.name}.join(' ')}"}
            %input{ :type => "hidden", :name => "id", :value => "#{@photo.id}"}
            %input{ :type => "submit", :value => "Update"}

:javascript
  const editTags = (event) => {
    event.stopPropagation();
    document.getElementById("tagList").style.display = "none";
    document.getElementById("editLink").style.display = "none";
    document.getElementById("updateTags").style.display = "block";
    document.getElementById("tags").focus();
  };
  document.getElementById("editLink").addEventListener("click", editTags, false);

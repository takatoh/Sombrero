%main
  %h3
    Rejected:
    = h @message
  %div{class: "miniPhoto border border-solid border-olive-500 rounded-md bg-white m-2 p-2 min-width-[170px] flex flex-row gap-2"}
    %div{class: "thumbnailBox p-2 min-w-[160px] min-h-[16]px flex justify-center"}
      %a{:href => '/images/' + @photo.path}
        %img{:src => '/images/' + @photo.thumbnail_path, class: "border border-solid border-gray-200"}
    %div{class: "photoInfo p-1"}
      %dl{class: "flex flex-wrap"}
        %dt{class: "w-[15%]"}
          MD5:
        %dd{class: "w-[85%]"}
          = h @photo.md5
        %dt{class: "w-[15%]"}
          Photo Id:
        %dd{class: "w-[85%]"}
          %a{:href => "/photo/#{@photo.id.to_s}", :class => "hover:underline"}= h @photo.id
        %dt{class: "w-[15%]"}
          Size:
        %dd{class: "w-[85%]"}
          = h(@photo.width.to_s + "x" + @photo.height.to_s)
        %dt{class: "w-[15%]"}
          File size:
        %dd{class: "w-[85%]"}
          = h @photo.filesize
        %dt{class: "w-[15%]"}
          Tags:
        %dd{class: "w-[85%]"}
          = h @photo.taggings.map{|t| t.tag.name}.join(' ')
        %dt{class: "w-[15%]"}
          Sources:
        %dd{class: "w-[85%]"}
          %ul
            - @photo.posts.each do |post|
              %li
                %a{:href => post.url, :class => "hover:underline"}= post.url
  - if @url_posted
    %div
      %a{ :href => "/" }= h "Back to recent"
  - else
    %div
      %form{ :action => "/clip", :method => "POST" }
        %input{ :type => "hidden", :name => "url", :value => @url }
        %input{ :type => "hidden", :name => "page_url", :value => @page_url }
        %input{ :type => "hidden", :name => "tags", :value => @tags }
        %input{ :type => "hidden", :name => "force", :value => true }
        %input{ :type => "submit", :value => "Force to clip/post" }
        OR
        %a{ :href => "/" }= h "Back to recent"

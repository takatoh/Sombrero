%div#main
  %div.pageNavi
    - unless @page.first_page?
      %span
        %a{:href => "/recent/#{@page.prev_page}"} &#171; Prev
    %span= "[ #{@page.current_page} / #{@page.page_count} ]"
    - unless @page.last_page?
      %span
        %a{:href => "/recent/#{@page.next_page}"} Next &#187;

  %div#recentList
    - @posts.each do |post|
      %div{class: "recentPhoto border border-solid border-olive-500 rounded-md bg-white m-2 p-2 min-width-[170px]"}
        %div{class: "grid grid-cols-8 border-b-1 border-gray-200"}
          %div{class: "postId col-span-6 font-bold"}
            = h('#' + post.id.to_s)
          %div{class: "control"}
            %a{ :href => ('/post/' + post.id.to_s + '.edit'), :onclick => "return hs.htmlExpand(this, { objectType: 'ajax', width: 500, height: 300 } )" } edit
          %div.control
            %a{ :href => ('/post/' + post.id.to_s + '.delete') } delete
        %div{class: "flex flex-row gap-2"}
          %div{class: "thumbnailBox p-2 min-w-[160px] min-h-[16]px flex justify-center"}
            %a{:href => '/images/' + post.photo.path, :target => '_blank', :rel => 'noopener noreferrer'}
              %img{src: '/images/' + post.photo.thumbnail_path, class: "border border-solid border-gray-200"}
          %div{class: "photoInfo p-1"}
            %dl{class: "flex flex-wrap"}
              %dt{class: "w-[15%]"}
                Tile:
              %dd{class: "w-[85%]"}
                = (post.title.nil? || post.title.empty?) ? "(untitled)" : post.title
              %dt{class: "w-[15%]"}
                Source:
              %dd{class: "w-[85%]"}
                %a{:href => post.url}= post.url
              %dt{class: "w-[15%]"}
                Webpage:
              %dd{class: "w-[85%]"}
                %a{:href => post.page_url}= post.page_url
              %dt{class: "w-[15%]"}
                Photo Id:
              %dd{class: "w-[85%]"}
                %a{:href => "/photo/#{post.photo.id.to_s}"}= h post.photo.id
              %dt{class: "w-[15%]"}
                Size:
              %dd{class: "w-[85%]"}
                = h(post.photo.width.to_s + "x" + post.photo.height.to_s)
              %dt{class: "w-[15%]"}
                File size:
              %dd{class: "w-[85%]"}
                = h post.photo.filesize
              %dt{class: "w-[15%]"}
                MD5:
              %dd{class: "w-[85%]"}
                = h post.photo.md5
              %dt{class: "w-[15%]"}
                SHA256:
              %dd{class: "w-[85%]"}
                = h post.photo.sha256
              %dt{class: "w-[15%]"}
                Tags:
              %dd{class: "w-[85%]"}
                = h post.photo.taggings.map{|t| t.tag.name.to_s}.sort.join(' ')
              %dt{class: "w-[15%]"}
                Posted:
              %dd{class: "w-[85%]"}
                = h post.datetime

  %div.pageNavi
    - unless @page.first_page?
      %span
        %a{:href => "/recent/#{@page.prev_page}"} &#171; Prev
    %span= "[ #{@page.current_page} / #{@page.page_count} ]"
    - unless @page.last_page?
      %span
        %a{:href => "/recent/#{@page.next_page}"} Next &#187;

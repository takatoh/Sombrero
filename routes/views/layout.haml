!!! 5

%html
  %head
    %title #{SOMBRERO_CONFIG["site_title"]}
    %meta{:"http-equiv" => "Content-Type", :comment => "text/html", :charset => "utf-8"}
    - @styles.each do |style|
      %link{:rel => "stylesheet", :type => "text/css", :href => "/#{style}.css"}


  %body{class: "flex justify-center bg-olive-100 text-slate-700"}
    %div{id: "container", class: "w-[900px]"}
      %div{id: "header", class: "h-24 mt-8 px-8 bg-olive-300 border-2 rounded-xl content-center grid grid-cols-9 gap-1"}
        %div{class: "col-span-7"}
          %h1.text-3xl
            %a{:href => "/"} #{SOMBRERO_CONFIG["site_title"]}
        %div{class: "h-8 w-20 bg-olive-600 rounded-full font-bold text-slate-300 flex justify-center items-center"}
          %a{:href => "/clip/new"} Clip
        %div{class: "h-8 w-20 bg-olive-600 rounded-full font-bold text-slate-300 flex justify-center items-center"}
          %a{:href => "/post/new"} Post
      %div{id: "menuBar", class: "py-4 flex flex-row justify-center gap-12"}
        %div{class: "basis-24 bg-slate-100 border-1 rounded-sm text-center"}
          %a{:href => "/recent/1"} Recent
        %div{class: "basis-24 bg-slate-100 border-1 rounded-sm text-center"}
          %a{:href => "/list/1"} List
        %div{class: "basis-24 bg-slate-100 border-1 rounded-sm text-center"}
          Gallery
        %div{class: "basis-24 bg-slate-100 border-1 rounded-sm text-center"}
          Directory
        %div{class: "basis-24 bg-slate-100 border-1 rounded-sm text-center"}
          %a{:href => "/tags/1"} Setting
      %div{id: "content", class: "pb-4"}
        != yield
      %div{id: "footer", class: "h-24 p-4 flex justify-center border-t-1 border-olive-400"}
        %span{class: "text-sm"}
          = "Sombrero v#{SOMBRERO_VERSION}"

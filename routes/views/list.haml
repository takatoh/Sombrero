%div#main
  %div.pageNavi
    %div{class: "flex flex-row justify-center gap-2"}
      - unless @page.first_page?
        %span
          %a{:href => "/list/#{@page.prev_page}"} &#171; Prev
      %span= "[ #{@page.current_page} / #{@page.page_count} ]"
      - unless @page.last_page?
        %span
          %a{:href => "/list/#{@page.next_page}"} Next &#187;

  %div#photoList
    - @photos.each do |photo|
      %div.photoBox
        %a{:href => '/photo/' + photo.id.to_s}
          %img.thumbnail{:src => '/images/' + photo.thumbnail_path}

  %div.pageNavi
    %div{class: "flex flex-row justify-center gap-2"}
      - unless @page.first_page?
        %span
          %a{:href => "/list/#{@page.prev_page}"} &#171; Prev
      %span= "[ #{@page.current_page} / #{@page.page_count} ]"
      - unless @page.last_page?
        %span
          %a{:href => "/list/#{@page.next_page}"} Next &#187;

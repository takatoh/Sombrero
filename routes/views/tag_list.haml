%div{class: "flex"}
  %div{id: "sidebar", class: "w-40"}
    %ul
      %li
        %a{:href => "/tags/1"} Tags
      %li
        %a{:href => "/tagtypes/1"} Tag types

  %div#main
    %h2{class: "text-2xl"}
      Tags

    %div{class: "pageNavi flex flex-row justify-center gap-2"}
      - unless @page.first_page?
        %span
          %a{:href => "/tags/#{@page.prev_page}"} &#171; Prev
      %span= "[ #{@page.current_page} / #{@page.page_count} ]"
      - unless @page.last_page?
        %span
          %a{:href => "/tags/#{@page.next_page}"} Next &#187;

    %div{id: "tagList", class: "py-2"}
      %table{class: "table-fixed border-collapse border-t-2 border-b-2 border-olive-400"}
        %thead
          %tr{class: "border-b-2 border-olive-400 bg-slate-200"}
            %th{class: "tagName w-36"}
              Tag name
            %th{class: "tagType w-24"}
              Tag type
            %th{class: "tagDescription w-66"}
              Description
            %th{class: "tagAliasFor w-36"}
              Alias for
            %th{class: "tagEdit w-16"}
        %tbody
          - @tags.each do |tag|
            %tr{class: "border-b border-olive-400 bg-white"}
              %td{class: "px-2"}
                = h tag.name
              %td{class: "px-2"}
                = h(tag.tag_type ? tag.tag_type.name : "")
              %td{class: "px-2"}
                = h tag.description
              %td{class: "px-2"}
                = h tag.alias_for || ""
              %td{class: "px-2"}
                %a{:href => "/tags/edit/#{tag.id}"} (edit)

    %div{class: "pageNavi flex flex-row justify-center gap-2"}
      - unless @page.first_page?
        %span
          %a{:href => "/tags/#{@page.prev_page}"} &#171; Prev
      %span= "[ #{@page.current_page} / #{@page.page_count} ]"
      - unless @page.last_page?
        %span
          %a{:href => "/tags/#{@page.next_page}"} Next &#187;
